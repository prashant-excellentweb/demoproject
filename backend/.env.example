SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Twilio SMS (leave empty to use console OTP in development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Redis for Channels
REDIS_URL=redis://127.0.0.1:6379/0

# Server port (daphne)
BACKEND_PORT=9000

# Static OTP for dev (default 111111). Set STATIC_OTP= to disable and use random OTP + SMS.
STATIC_OTP=111111

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
